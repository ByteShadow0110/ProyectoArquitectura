<%- include('../../partials/layout-start') %>
<%
  const TIPO = { refaccion: 'Refacción', herramienta: 'Herramienta', equipo: 'Equipo' };
  const ESTADO = { disponible: ['b-ok', 'Disponible'], asignado: ['b-info', 'Asignado'], mantenimiento: ['b-warn', 'Mantenimiento'], baja: ['b-mute', 'Baja'] };
  const qs = (p) => {
    const params = new URLSearchParams();
    if (filters.q) params.set('q', filters.q);
    if (filters.tipo) params.set('tipo', filters.tipo);
    if (filters.estado) params.set('estado', filters.estado);
    if (filters.vigencia !== 'activos') params.set('vigencia', filters.vigencia);
    if (p > 1) params.set('page', p);
    const s = params.toString();
    return '/activos' + (s ? '?' + s : '');
  };
%>
<div class="card">
  <form class="toolbar" method="get" action="/activos">
    <div class="search"><%- icon('search', 'sm') %>
      <input type="search" name="q" value="<%= filters.q %>" placeholder="Buscar por SKU, nombre o modelo compatible" aria-label="Buscar"></div>
    <select name="tipo" aria-label="Tipo">
      <option value="">Todos los tipos</option>
      <% Object.keys(TIPO).forEach(t => { %><option value="<%= t %>" <%= filters.tipo === t ? 'selected' : '' %>><%= TIPO[t] %></option><% }) %>
    </select>
    <select name="estado" aria-label="Estado">
      <option value="">Todos los estados</option>
      <% Object.keys(ESTADO).forEach(e => { %><option value="<%= e %>" <%= filters.estado === e ? 'selected' : '' %>><%= ESTADO[e][1] %></option><% }) %>
    </select>
    <select name="vigencia" aria-label="Vigencia">
      <option value="activos" <%= filters.vigencia === 'activos' ? 'selected' : '' %>>Vigentes</option>
      <option value="inactivos" <%= filters.vigencia === 'inactivos' ? 'selected' : '' %>>De baja</option>
      <option value="todos" <%= filters.vigencia === 'todos' ? 'selected' : '' %>>Todos</option>
    </select>
    <button class="btn sec" type="submit"><%- icon('search', 'sm') %>Filtrar</button>
    <% if (canManage) { %><a class="btn" href="/activos/nuevo"><%- icon('add', 'sm') %>Nuevo activo</a><% } %>
  </form>

  <div class="table-wrap"><table class="table-stack">
    <thead><tr><th>SKU</th><th>Nombre</th><th>Tipo</th><th>Stock</th><th>Estado</th><th></th></tr></thead>
    <tbody>
      <% if (!rows.length) { %>
        <tr><td colspan="6" class="empty row-empty">No se encontraron activos con esos filtros.</td></tr>
      <% } %>
      <% rows.forEach(a => { %>
        <tr>
          <td data-label="SKU"><%= a.codigo %></td>
          <td data-label="Nombre"><%= a.nombre %></td>
          <td data-label="Tipo"><%= TIPO[a.tipo] %></td>
          <td data-label="Stock"><% if (a.tipo === 'refaccion') { %>
            <span class="badge <%= a.stock <= a.stock_minimo ? 'b-bad' : 'b-ok' %>"><%= a.stock %> / <%= a.stock_minimo %></span>
          <% } else { %>—<% } %></td>
          <td data-label="Estado"><span class="badge <%= ESTADO[a.estado][0] %>"><%= ESTADO[a.estado][1] %></span></td>
          <td><div class="actions"><a class="btn sm sec" href="/activos/<%= a.id %>"><%- icon('view', 'sm') %>Ver</a></div></td>
        </tr>
      <% }) %>
    </tbody>
  </table></div>

  <div class="pager">
    <span><%= total %> resultado<%= total === 1 ? '' : 's' %> · página <%= page %> de <%= pages %></span>
    <span class="btn-row" style="margin:0">
      <a class="btn sec sm <%= page <= 1 ? 'disabled' : '' %>" href="<%= qs(page - 1) %>">Anterior</a>
      <a class="btn sec sm <%= page >= pages ? 'disabled' : '' %>" href="<%= qs(page + 1) %>">Siguiente</a>
    </span>
  </div>
</div>
<%- include('../../partials/layout-end') %>
