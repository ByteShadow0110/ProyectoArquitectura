<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %> · RefaccionesMX</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
<%- include('../../partials/icons') %>
<div class="auth">
  <section class="auth-side">
    <div class="logo"><%- icon('phone') %><span>Refacciones<b>MX</b></span></div>
    <p>Gestión de personal y activos de tu tienda de refacciones para dispositivos móviles.</p>
  </section>
  <main class="auth-main">
    <div class="auth-card">
      <h1>Iniciar sesión</h1>
      <p class="sub">Ingresa con tu cuenta para continuar.</p>
      <% if (errorMessage) { %><div class="alert error" role="alert"><%- icon('error') %><span><%= errorMessage %></span></div><% } %>
      <form method="post" action="/login" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field"><label for="correo">Correo</label>
          <input id="correo" name="correo" type="email" value="<%= correo %>" autocomplete="username" required autofocus></div>
        <div class="field"><label for="password">Contraseña</label>
          <input id="password" name="password" type="password" autocomplete="current-password" required></div>
        <button class="btn" style="width:100%" type="submit"><%- icon('lock', 'sm') %>Iniciar sesión</button>
      </form>
    </div>
  </main>
</div>
</body>
</html>
