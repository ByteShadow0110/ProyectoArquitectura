<%- include('../../partials/layout-start') %>
<%
  const qs = (p) => {
    const params = new URLSearchParams();
    if (filters.q) params.set('q', filters.q);
    if (user.rol !== 'supervisor' && filters.area) params.set('area', filters.area);
    if (filters.estado !== 'activos') params.set('estado', filters.estado);
    if (p > 1) params.set('page', p);
    const s = params.toString();
    return '/personas' + (s ? '?' + s : '');
  };
%>
<div class="card">
  <form class="toolbar" method="get" action="/personas">
    <div class="search"><%- icon('search', 'sm') %>
      <input type="search" name="q" value="<%= filters.q %>" placeholder="Buscar por nombre o puesto" aria-label="Buscar"></div>
    <% if (user.rol !== 'supervisor') { %>
    <select name="area" aria-label="Área">
      <option value="">Todas las áreas</option>
      <% areas.forEach(a => { %><option value="<%= a.id %>" <%= String(filters.area) === String(a.id) ? 'selected' : '' %>><%= a.nombre %></option><% }) %>
    </select>
    <% } %>
    <select name="estado" aria-label="Estado">
      <option value="activos" <%= filters.estado === 'activos' ? 'selected' : '' %>>Activos</option>
      <option value="inactivos" <%= filters.estado === 'inactivos' ? 'selected' : '' %>>Inactivos</option>
      <option value="todos" <%= filters.estado === 'todos' ? 'selected' : '' %>>Todos</option>
    </select>
    <button class="btn sec" type="submit"><%- icon('search', 'sm') %>Filtrar</button>
    <% if (canManage) { %><a class="btn" href="/personas/nueva"><%- icon('add', 'sm') %>Nueva persona</a><% } %>
  </form>

  <div class="table-wrap"><table class="table-stack">
    <thead><tr><th>Nombre</th><th>Área</th><th>Puesto</th><th>Ingreso</th><th>Estado</th><th></th></tr></thead>
    <tbody>
      <% if (!rows.length) { %>
        <tr><td colspan="6" class="empty row-empty">No se encontraron personas con esos filtros.</td></tr>
      <% } %>
      <% rows.forEach(p => { %>
        <tr>
          <td data-label="Nombre"><%= p.nombre %> <%= p.apellidos %></td>
          <td data-label="Área"><%= p.area || '—' %></td>
          <td data-label="Puesto"><%= p.puesto || '—' %></td>
          <td data-label="Ingreso"><%= fmtDate(p.fecha_ingreso) %></td>
          <td data-label="Estado"><span class="badge <%= p.activo ? 'b-ok' : 'b-mute' %>"><%= p.activo ? 'Activo' : 'Inactivo' %></span></td>
          <td><div class="actions"><a class="btn sm sec" href="/personas/<%= p.id %>"><%- icon('view', 'sm') %>Expediente</a></div></td>
        </tr>
      <% }) %>
    </tbody>
  </table></div>

  <div class="pager">
    <span><%= total %> resultado<%= total === 1 ? '' : 's' %> · página <%= page %> de <%= pages %></span>
    <span class="btn-row" style="margin:0">
      <a class="btn sec sm <%= page <= 1 ? 'disabled' : '' %>" href="<%= qs(page - 1) %>">Anterior</a>
      <a class="btn sec sm <%= page >= pages ? 'disabled' : '' %>" href="<%= qs(page + 1) %>">Siguiente</a>
    </span>
  </div>
</div>
<%- include('../../partials/layout-end') %>
